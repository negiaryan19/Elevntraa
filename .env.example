# Bench / script configuration ONLY. The Flutter app does NOT read this file
# any more: it is configured at build time with
#   --dart-define-from-file=config/app_config.json   (see config/app_config.example.json)
#
# scripts/bench_v2 (Deno) and scripts/golden_audio_bench (Dart) read the keys
# below from a gitignored .env at the repo root.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# A dedicated TEST doctor account the benches sign in with (never a real doctor).
AUTO_LOGIN_EMAIL=bench@example.com
AUTO_LOGIN_PASSWORD=change-me
# Provider keys used only by scripts/bench_v2 (the app never sees them).
SARVAM_API_KEY=
GEMINI_API_KEY=
