<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer (backup_rules.xml
     covers Android 11 and older). Everything is backed up as before except
     flutter_secure_storage's files: the doctor's encrypted session and the
     wrapped key for it. The Keystore key that unwraps it never leaves this
     phone, so a restored copy could only fail to decrypt; without them a
     restored phone simply asks the doctor to sign in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
